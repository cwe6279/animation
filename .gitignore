# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environment
venv/
.venv/

# IDE
.vscode/
.idea/

# Claude Code
.claude/

# OS
.DS_Store
Thumbs.db

# Audio temp files and any recorded voice, in whatever container
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.opus
*.webm

# Illustrator temp files
*.ai
~*_.tmp

# Tests
.pytest_cache/

# Secrets. .env.example is the committed template; every other variant stays out,
# including .env.local and a .env.pi written for a kiosk.
.env
**/.env
.env.*
!.env.example

# Camera emergency captures (contain images of people, and notes describing them).
# note.json is matched anywhere because --emergency-dir can point outside emergencies/.
emergencies/
**/note.json

# Camera images and mic recordings: never commit pictures or voices of people
*.jpg
*.jpeg
snapshots/
recordings/

# Session logs (contain transcripts of conversations)
logs/

# Per-machine mic/speaker calibration (voice_loop.py --calibrate)
calibration.json

# local TTS benchmark environment (tools/bench_tts_local.py)
.bench-venv/
.bench-models/

# An assistant's working memory (talker/memory_notes.py): your notes and tasks, not the project's
faces/*/notes.md
faces/*/tasks.md
