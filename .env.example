# Copy this file to .env and fill in your own keys. .env is gitignored — never commit it.

# Claude (LLM replies in voice_loop.py / claude_stream.py)
# Get one at https://console.anthropic.com/settings/keys — create it inside a
# workspace. The API is prepaid: add credits under Plans & Billing first.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is organization-wide rather than workspace-scoped:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# ElevenLabs (optional, lower-latency voice: --tts elevenlabs)
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Optional, for side-by-side comparison (voice_loop.py --llm openai, --stt openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
