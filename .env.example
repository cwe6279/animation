# Copy this file to .env and fill in your own keys. .env is gitignored — never commit it.

# Claude (LLM replies in voice_loop.py / claude_stream.py)
# Get one at https://console.anthropic.com/settings/keys — create it inside a
# workspace. The API is prepaid: add credits under Plans & Billing first.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if your key is organization-wide rather than workspace-scoped:
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# ElevenLabs (optional, lower-latency voice: --tts elevenlabs)
# Get one at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=sk_...

# Optional, for side-by-side comparison (voice_loop.py --llm openai, --stt openai)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Optional: Fish Audio voices (voice_loop.py --tts fish --voice <reference id>)
# https://fish.audio/app/developers  (API credit is separate from site credit)
FISH_AUDIO_API_KEY=...

# Optional: a local Ollama brain (voice_loop.py --llm ollama --model <name>); no key needed
# Local voice (--tts piper): a Piper voice name; downloads once to ~/.cache/talker/piper
# PIPER_VOICE=en_US-hfc_female-medium

# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=<name from --list-models>

# Optional: a backend agent for a face with "errands": true (tools/agent_relay.py on the
# machine that has your agent harness). {{task ...}} goes there; the result is announced.
# AGENT_RELAY_URL=http://agentbox:8030
